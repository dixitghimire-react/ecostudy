<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoStudy Portal</title>
    <!-- Theme Initializer: Runs before render to prevent flash of wrong theme -->
    <script>
        (function() {
            var savedTheme = localStorage.getItem('ecostudy_theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
            if (savedTheme === 'dark') {
                document.documentElement.classList.add('dark-theme');
            }
        })();
    </script>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var isTeacher = User.IsInRole("Teacher");
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <!-- Mobile Sidebar Backdrop Overlay -->
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <div class="dashboard-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="dashboard-sidebar" id="dashboardSidebar">
            <!-- Sidebar Header / Brand -->
            <div class="sidebar-brand">
                <a asp-controller="@(isTeacher ? "Teacher" : "Student")" asp-action="Dashboard" class="d-flex align-items-center gap-2 text-decoration-none text-white">
                    <div class="rounded-3 bg-primary text-white d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <span>Eco<span class="text-info">Study</span></span>
                </a>
                <!-- Mobile Close Sidebar Button -->
                <button type="button" class="btn btn-sm btn-link text-white text-opacity-50 d-lg-none p-0" id="sidebarCloseBtn" aria-label="Close Sidebar">
                    <i class="bi bi-x-lg fs-5"></i>
                </button>
            </div>

            <!-- Role Badge Banner -->
            <div class="px-3 pt-3 pb-1">
                @if (isTeacher)
                {
                    <div class="p-2 rounded-3 bg-primary bg-opacity-20 border border-primary border-opacity-30 d-flex align-items-center gap-2 text-white small">
                        <i class="bi bi-person-workspace text-primary fs-5"></i>
                        <div>
                            <div class="fw-bold">Teacher Portal</div>
                            <div class="text-secondary small" style="font-size: 0.72rem;">Faculty Control Center</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="p-2 rounded-3 bg-info bg-opacity-20 border border-info border-opacity-30 d-flex align-items-center gap-2 text-white small">
                        <i class="bi bi-mortarboard text-info fs-5"></i>
                        <div>
                            <div class="fw-bold">Student Portal</div>
                            <div class="text-secondary small" style="font-size: 0.72rem;">Economics Learning Hub</div>
                        </div>
                    </div>
                }
            </div>

            <!-- Navigation Links -->
            <ul class="sidebar-nav">
                <li class="nav-section-title">Navigation</li>

                @if (isTeacher)
                {
                    <li class="sidebar-item">
                        <a class="sidebar-link @(currentController == "Teacher" && currentAction == "Dashboard" ? "active" : "")" 
                           asp-controller="Teacher" asp-action="Dashboard">
                            <i class="bi bi-grid-1x2-fill"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(currentController == "Teacher" && currentAction == "Chapters" ? "active" : "")" 
                           asp-controller="Teacher" asp-action="Chapters">
                            <i class="bi bi-journal-bookmark-fill"></i>
                            <span>Chapters</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(currentController == "Teacher" && currentAction == "Notes" ? "active" : "")" 
                           asp-controller="Teacher" asp-action="Notes">
                            <i class="bi bi-file-earmark-text-fill"></i>
                            <span>Notes</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(currentController == "Teacher" && currentAction == "ImportantQuestions" ? "active" : "")" 
                           asp-controller="Teacher" asp-action="ImportantQuestions">
                            <i class="bi bi-patch-question-fill"></i>
                            <span>Important Questions</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(currentController == "Teacher" && currentAction == "Students" ? "active" : "")" 
                           asp-controller="Teacher" asp-action="Students">
                            <i class="bi bi-people-fill"></i>
                            <span>Students</span>
                        </a>
                    </li>
                }
                else
                {
                    <li class="sidebar-item">
                        <a class="sidebar-link @(currentController == "Student" && currentAction == "Dashboard" ? "active" : "")" 
                           asp-controller="Student" asp-action="Dashboard">
                            <i class="bi bi-grid-1x2-fill"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(currentController == "Student" && currentAction == "Chapters" ? "active" : "")" 
                           asp-controller="Student" asp-action="Chapters">
                            <i class="bi bi-journal-bookmark-fill"></i>
                            <span>Chapters</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(currentController == "Student" && currentAction == "Notes" ? "active" : "")" 
                           asp-controller="Student" asp-action="Notes">
                            <i class="bi bi-file-earmark-text-fill"></i>
                            <span>Notes</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(currentController == "Student" && currentAction == "ImportantQuestions" ? "active" : "")" 
                           asp-controller="Student" asp-action="ImportantQuestions">
                            <i class="bi bi-patch-question-fill"></i>
                            <span>Important Questions</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(currentController == "Student" && currentAction == "Profile" ? "active" : "")" 
                           asp-controller="Student" asp-action="Profile">
                            <i class="bi bi-person-badge-fill"></i>
                            <span>Profile</span>
                        </a>
                    </li>
                }

                <li class="nav-section-title mt-3">Quick Search</li>
                <li class="sidebar-item">
                    <a class="sidebar-link @(currentController == "Home" && currentAction == "Search" ? "active" : "")" 
                       asp-controller="Home" asp-action="Search">
                        <i class="bi bi-search"></i>
                        <span>Global Search</span>
                    </a>
                </li>
            </ul>

            <!-- Sidebar Footer with Logout -->
            <div class="sidebar-footer">
                <form asp-controller="Account" asp-action="Logout" method="post" id="sidebarLogoutForm">
                    <button type="submit" class="sidebar-logout-btn">
                        <i class="bi bi-box-arrow-right me-2"></i>
                        <span>Logout</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Workspace -->
        <div class="dashboard-main">
            <!-- Topbar Header -->
            <header class="dashboard-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" id="sidebarToggleBtn" aria-label="Toggle navigation">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">@ViewData["Title"]</h5>
                        <div class="text-muted small d-none d-sm-block">EcoStudy Portal &bull; Academic Year @DateTime.UtcNow.Year</div>
                    </div>
                </div>

                <!-- Center: Global Search Bar -->
                <form asp-controller="Home" asp-action="Search" method="get" class="topbar-search-form d-none d-md-block">
                    <div class="position-relative">
                        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted" style="font-size: 0.85rem;"></i>
                        <input type="text" name="q" class="form-control topbar-search-input" placeholder="Search chapters, notes, questions..." />
                    </div>
                </form>

                <!-- Right Topbar Controls -->
                <div class="d-flex align-items-center gap-2 gap-sm-3">
                    <!-- Mobile Search Icon -->
                    <a asp-controller="Home" asp-action="Search" class="btn btn-sm btn-outline-secondary d-md-none rounded-circle p-2" title="Search">
                        <i class="bi bi-search"></i>
                    </a>

                    <!-- Dark / Light Theme Toggle -->
                    <button type="button" class="theme-toggle-btn" id="themeToggleBtn" title="Toggle Light / Dark Mode" aria-label="Toggle theme">
                        <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                    </button>

                    <!-- Public Home Link -->
                    <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-none d-lg-inline-flex align-items-center gap-1">
                        <i class="bi bi-house"></i> Public Home
                    </a>

                    <!-- User Profile Avatar & Badge -->
                    <div class="d-flex align-items-center gap-2 ps-2 border-start">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 36px; height: 36px; font-size: 0.95rem;">
                            @(User.Identity?.Name != null && User.Identity.Name.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "U")
                        </div>
                        <div class="d-none d-sm-block text-start">
                            <div class="fw-semibold text-dark small text-truncate" style="max-width: 140px;">
                                @(User.Identity?.Name)
                            </div>
                            <div class="badge @(isTeacher ? "bg-primary" : "bg-info text-dark")" style="font-size: 0.68rem;">
                                @(isTeacher ? "Teacher" : "Student")
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Main Dynamic Body Area -->
            <main class="dashboard-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4 rounded-4 shadow-sm border-0" role="alert">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                        <div>@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4 rounded-4 shadow-sm border-0" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div>@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Theme Switcher Logic
        function updateThemeIcon(theme) {
            var icon = document.getElementById('themeIcon');
            if (!icon) return;
            if (theme === 'dark') {
                icon.className = 'bi bi-sun-fill text-warning';
            } else {
                icon.className = 'bi bi-moon-stars-fill';
            }
        }

        var currentTheme = localStorage.getItem('ecostudy_theme') || 'light';
        updateThemeIcon(currentTheme);

        document.getElementById('themeToggleBtn')?.addEventListener('click', function() {
            var activeTheme = document.documentElement.getAttribute('data-bs-theme') || 'light';
            var nextTheme = activeTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-bs-theme', nextTheme);
            if (nextTheme === 'dark') {
                document.documentElement.classList.add('dark-theme');
            } else {
                document.documentElement.classList.remove('dark-theme');
            }
            localStorage.setItem('ecostudy_theme', nextTheme);
            updateThemeIcon(nextTheme);
        });

        // Mobile Sidebar Drawer and Backdrop Logic
        var sidebar = document.getElementById('dashboardSidebar');
        var backdrop = document.getElementById('sidebarBackdrop');
        var toggleBtn = document.getElementById('sidebarToggleBtn');
        var closeBtn = document.getElementById('sidebarCloseBtn');

        function openSidebar() {
            sidebar?.classList.add('show');
            backdrop?.classList.add('show');
        }

        function closeSidebar() {
            sidebar?.classList.remove('show');
            backdrop?.classList.remove('show');
        }

        toggleBtn?.addEventListener('click', openSidebar);
        closeBtn?.addEventListener('click', closeSidebar);
        backdrop?.addEventListener('click', closeSidebar);

        // Auto Loading State for Forms on Submit
        document.querySelectorAll('form').forEach(function(form) {
            form.addEventListener('submit', function(e) {
                // If form is valid, show spinner on submit button
                if (form.checkValidity()) {
                    var submitBtn = form.querySelector('button[type="submit"]');
                    if (submitBtn && !submitBtn.classList.contains('no-loader')) {
                        submitBtn.classList.add('loading');
                        var originalHtml = submitBtn.innerHTML;
                        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Processing...';
                    }
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
