@model IEnumerable<EcoStudy.Models.ImportantQuestion>

@{
    ViewData["Title"] = "Important Questions";
    Layout = "_DashboardLayout";

    var chapters = ViewBag.Chapters as List<EcoStudy.Models.Chapter> ?? new List<EcoStudy.Models.Chapter>();
    int? selectedChapterId = ViewBag.SelectedChapterId;
    string? selectedQuestionType = ViewBag.SelectedQuestionType;
    string? searchTerm = ViewBag.SearchTerm;

    int totalCount = ViewBag.TotalCount ?? Model.Count();
    int shortCount = ViewBag.ShortCount ?? Model.Count(q => q.QuestionType == "Short");
    int longCount = ViewBag.LongCount ?? Model.Count(q => q.QuestionType == "Long");
    int numericalCount = ViewBag.NumericalCount ?? Model.Count(q => q.QuestionType == "Numerical");
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">⭐ Important Economics Questions</h2>
        <p class="text-muted small mb-0">High-yield board examination questions categorized by question type with scoring guidelines and solution hints.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold border border-primary border-opacity-25">
            <i class="bi bi-collection me-1"></i> @Model.Count() Questions Shown
        </span>
    </div>
</div>

<!-- Search and Filter Bar -->
<div class="custom-card p-3 mb-4">
    <form method="get" asp-controller="Student" asp-action="ImportantQuestions" class="row g-3 align-items-center">
        <!-- Search Field -->
        <div class="col-lg-5 col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Search questions, concepts, formulas..." value="@searchTerm" />
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <a asp-controller="Student" asp-action="ImportantQuestions" asp-route-chapterId="@selectedChapterId" asp-route-questionType="@selectedQuestionType" class="btn btn-outline-secondary" title="Clear search">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </div>

        <!-- Chapter Filter -->
        <div class="col-lg-4 col-md-4">
            <select name="chapterId" class="form-select" onchange="this.form.submit()">
                <option value="">All Chapters (@chapters.Count)</option>
                @foreach (var ch in chapters)
                {
                    <option value="@ch.Id" selected="@(selectedChapterId == ch.Id)">
                        Chapter @ch.ChapterNumber: @ch.Name
                    </option>
                }
            </select>
        </div>

        <!-- Question Type Filter Dropdown (also mirrored in pills below) -->
        <div class="col-lg-3 col-md-2 d-flex gap-2">
            <select name="questionType" class="form-select" onchange="this.form.submit()">
                <option value="All" selected="@(string.IsNullOrEmpty(selectedQuestionType) || selectedQuestionType == "All")">All Types</option>
                <option value="Short" selected="@(selectedQuestionType == "Short")">Short Questions</option>
                <option value="Long" selected="@(selectedQuestionType == "Long")">Long Questions</option>
                <option value="Numerical" selected="@(selectedQuestionType == "Numerical")">Numerical Questions</option>
            </select>
            @if (selectedChapterId.HasValue || !string.IsNullOrEmpty(selectedQuestionType) || !string.IsNullOrEmpty(searchTerm))
            {
                <a asp-controller="Student" asp-action="ImportantQuestions" class="btn btn-outline-secondary" title="Reset filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            }
        </div>
    </form>

    <!-- Question Type Filter Tabs / Pills -->
    <div class="d-flex flex-wrap gap-2 pt-3 mt-3 border-top align-items-center">
        <span class="small text-muted fw-semibold me-2">Filter by Type:</span>
        <a asp-controller="Student" asp-action="ImportantQuestions" asp-route-chapterId="@selectedChapterId" asp-route-search="@searchTerm"
           class="badge rounded-pill text-decoration-none px-3 py-2 @(string.IsNullOrEmpty(selectedQuestionType) || selectedQuestionType == "All" ? "bg-dark text-white" : "bg-light text-dark border")">
            All Questions (@totalCount)
        </a>
        <a asp-controller="Student" asp-action="ImportantQuestions" asp-route-chapterId="@selectedChapterId" asp-route-questionType="Short" asp-route-search="@searchTerm"
           class="badge rounded-pill text-decoration-none px-3 py-2 @(selectedQuestionType == "Short" ? "bg-primary text-white" : "bg-light text-dark border")">
            📝 Short Questions (@shortCount)
        </a>
        <a asp-controller="Student" asp-action="ImportantQuestions" asp-route-chapterId="@selectedChapterId" asp-route-questionType="Long" asp-route-search="@searchTerm"
           class="badge rounded-pill text-decoration-none px-3 py-2 @(selectedQuestionType == "Long" ? "bg-secondary text-white" : "bg-light text-dark border")" style="@(selectedQuestionType == "Long" ? "background-color: #7c3aed !important;" : "")">
            📄 Long Questions (@longCount)
        </a>
        <a asp-controller="Student" asp-action="ImportantQuestions" asp-route-chapterId="@selectedChapterId" asp-route-questionType="Numerical" asp-route-search="@searchTerm"
           class="badge rounded-pill text-decoration-none px-3 py-2 @(selectedQuestionType == "Numerical" ? "bg-success text-white" : "bg-light text-dark border")">
            🔢 Numerical Problems (@numericalCount)
        </a>
    </div>
</div>

<!-- Questions Grid -->
@if (!Model.Any())
{
    <div class="custom-card p-5 text-center">
        <div class="display-5 text-muted mb-3"><i class="bi bi-patch-question"></i></div>
        <h5 class="fw-bold text-dark">No Important Questions Found</h5>
        <p class="text-muted small mb-3">No questions matched your search or filter selection. Try selecting another chapter or clearing your search.</p>
        <a asp-controller="Student" asp-action="ImportantQuestions" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
        </a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var q in Model)
        {
            var typeBadgeClass = q.QuestionType switch
            {
                "Short" => "bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25",
                "Long" => "bg-info bg-opacity-10 text-dark border border-info border-opacity-25",
                "Numerical" => "bg-success bg-opacity-10 text-success border border-success border-opacity-25",
                _ => "bg-secondary bg-opacity-10 text-secondary"
            };

            var typeIcon = q.QuestionType switch
            {
                "Short" => "bi-pencil-square",
                "Long" => "bi-journal-text",
                "Numerical" => "bi-calculator",
                _ => "bi-question-circle"
            };

            <div class="col-lg-6">
                <div class="custom-card h-100 p-4 d-flex flex-column justify-content-between shadow-sm">
                    <div>
                        <!-- Header Row -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @typeBadgeClass px-3 py-1 rounded-pill fw-semibold">
                                    <i class="bi @typeIcon me-1"></i>@q.QuestionType
                                </span>
                                <span class="badge bg-secondary bg-opacity-10 text-dark border">
                                    @q.Marks Marks
                                </span>
                            </div>
                            <span class="badge bg-dark bg-opacity-75 rounded-pill text-white px-3 py-1">
                                Ch @(q.Chapter?.ChapterNumber)
                            </span>
                        </div>

                        <!-- Question Statement with reading-friendly styling -->
                        <h5 class="fw-bold text-dark mb-3" style="line-height: 1.6; font-size: 1.05rem;">
                            @q.Question
                        </h5>

                        <!-- Meta tags (Chapter name, Exam reference) -->
                        <div class="d-flex flex-wrap align-items-center gap-3 mb-3 text-muted small">
                            <span title="Chapter">
                                <i class="bi bi-book me-1 text-primary"></i>@(q.Chapter?.Name ?? "General")
                            </span>
                            @if (!string.IsNullOrEmpty(q.ExamReference))
                            {
                                <span title="Exam Reference">
                                    <i class="bi bi-award me-1 text-warning"></i>@q.ExamReference
                                </span>
                            }
                        </div>

                        <!-- Solution Key / Scoring Outline (Collapsible for active recall study) -->
                        @if (!string.IsNullOrWhiteSpace(q.AnswerHint))
                        {
                            <div class="mt-3">
                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 d-inline-flex align-items-center gap-1"
                                        type="button" data-bs-toggle="collapse" data-bs-target="#hint-@q.Id" aria-expanded="false" aria-controls="hint-@q.Id">
                                    <i class="bi bi-lightbulb text-warning"></i>
                                    <span>Toggle Solution Key / Key Points</span>
                                </button>
                                <div class="collapse mt-2" id="hint-@q.Id">
                                    <div class="p-3 bg-light rounded-4 border-start border-4 border-warning small text-secondary" style="line-height: 1.7;">
                                        <div class="fw-bold text-dark mb-1">
                                            <i class="bi bi-check-circle-fill text-success me-1"></i> Key Scoring Points:
                                        </div>
                                        @q.AnswerHint
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Footer Link back to Chapter -->
                    <div class="pt-3 border-top mt-3 d-flex justify-content-between align-items-center text-muted small">
                        <span>Chapter @(q.Chapter?.ChapterNumber)</span>
                        <a asp-controller="Student" asp-action="ChapterDetails" asp-route-id="@q.ChapterId" class="text-decoration-none fw-semibold">
                            Open Chapter <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
