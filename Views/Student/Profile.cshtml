@model EcoStudy.Models.ApplicationUser

@{
    ViewData["Title"] = "Student Profile";
    Layout = "_DashboardLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="custom-card p-4">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-2" style="width: 72px; height: 72px;">
                    @(Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "S")
                </div>
                <div>
                    <h4 class="fw-bold text-dark mb-0">@Model.FullName</h4>
                    <div class="text-muted small">@Model.Email</div>
                    <span class="badge badge-soft-primary mt-1">@Model.UserRole Account</span>
                </div>
            </div>

            <form asp-controller="Student" asp-action="Profile" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small text-secondary">Full Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                            <input name="fullName" value="@Model.FullName" class="form-control bg-light border-start-0 ps-0" required />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small text-secondary">Email Address (Read-only)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                            <input value="@Model.Email" class="form-control bg-light border-start-0 ps-0 text-muted" disabled readonly />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small text-secondary">Class / Academic Level</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-mortarboard text-muted"></i></span>
                            <select name="gradeOrLevel" class="form-select bg-light border-start-0 ps-0">
                                <option value="Grade 11 Economics" selected="@(Model.GradeOrLevel == "Grade 11 Economics")">Grade 11 Economics</option>
                                <option value="Grade 12 Economics" selected="@(Model.GradeOrLevel == "Grade 12 Economics")">Grade 12 Economics</option>
                                <option value="Undergraduate Economics" selected="@(Model.GradeOrLevel == "Undergraduate Economics")">Undergraduate Economics</option>
                                <option value="Competitive Exam Prep" selected="@(Model.GradeOrLevel == "Competitive Exam Prep")">Competitive Exam Prep</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small text-secondary">Member Since</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar3 text-muted"></i></span>
                            <input value="@Model.CreatedAt.ToString("MMMM dd, yyyy")" class="form-control bg-light border-start-0 ps-0 text-muted" disabled readonly />
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary-custom px-4">
                        <i class="bi bi-check2 me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
