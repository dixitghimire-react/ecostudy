@model IEnumerable<EcoStudy.Models.Note>
@inject EcoStudy.Services.IFileService FileService

@{
    ViewData["Title"] = "Economics Study Notes";
    Layout = "_DashboardLayout";
    var chapters = ViewBag.Chapters as List<EcoStudy.Models.Chapter> ?? new List<EcoStudy.Models.Chapter>();
    int? selectedChapterId = ViewBag.SelectedChapterId as int?;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Economics Study Notes &amp; Handouts</h3>
        <p class="text-muted small mb-0">Download verified lecture notes, revision guides, and presentation slides</p>
    </div>

    <!-- Chapter Filter -->
    <div class="d-flex align-items-center gap-2">
        <label class="text-muted small text-nowrap fw-semibold"><i class="bi bi-funnel me-1"></i>Filter Chapter:</label>
        <select class="form-select form-select-sm" onchange="location = this.value;" style="min-width: 200px;">
            <option value="@Url.Action("Notes", "Student")">All Chapters (@chapters.Count)</option>
            @foreach (var ch in chapters)
            {
                if (selectedChapterId == ch.Id)
                {
                    <option value="@Url.Action("Notes", "Student", new { chapterId = ch.Id })" selected>
                        Ch @ch.ChapterNumber: @ch.Name
                    </option>
                }
                else
                {
                    <option value="@Url.Action("Notes", "Student", new { chapterId = ch.Id })">
                        Ch @ch.ChapterNumber: @ch.Name
                    </option>
                }
            }
        </select>
    </div>
</div>

<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="p-5 text-center bg-white rounded-4 border">
                <i class="bi bi-file-earmark-x fs-1 text-muted"></i>
                <h5 class="fw-bold mt-2">No Notes Found</h5>
                <p class="text-muted small mb-3">No study documents are available for the selected chapter.</p>
                <a asp-controller="Student" asp-action="Notes" class="btn btn-outline-primary btn-sm">Reset Filter</a>
            </div>
        </div>
    }
    else
    {
        @foreach (var note in Model)
        {
            <div class="col-lg-6">
                <div class="custom-card h-100 p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            @if (note.Chapter != null)
                            {
                                <span class="badge bg-secondary">Ch @note.Chapter.ChapterNumber: @note.Chapter.Name</span>
                            }
                            <span class="badge @FileService.GetFileBadgeClass(note.FileType) text-uppercase">
                                <i class="bi @FileService.GetFileIcon(note.FileType) me-1"></i>@note.FileType.TrimStart('.')
                            </span>
                        </div>

                        <h5 class="fw-bold text-dark mb-2">
                            <a asp-controller="Student" asp-action="NoteDetails" asp-route-id="@note.Id" class="text-decoration-none text-dark hover-primary">
                                @note.Title
                            </a>
                        </h5>

                        <p class="text-secondary small mb-3" style="line-height: 1.6;">
                            @(string.IsNullOrWhiteSpace(note.Description) ? "Faculty revision notes and key concept breakdowns." : note.Description)
                        </p>
                    </div>

                    <div class="border-top pt-3 mt-2">
                        <div class="d-flex justify-content-between align-items-center mb-3 small text-muted">
                            <span class="text-truncate" style="max-width: 170px;" title="@note.FileName">
                                <i class="bi bi-paperclip me-1"></i>@note.FileName
                            </span>
                            <span>
                                <i class="bi bi-hdd me-1"></i>@FileService.FormatFileSize(note.FileSize)
                            </span>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-controller="Student" asp-action="DownloadNote" asp-route-id="@note.Id" 
                               class="btn btn-primary-custom flex-fill d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-download"></i>
                                <span>Download Note</span>
                            </a>
                            <a asp-controller="Student" asp-action="NoteDetails" asp-route-id="@note.Id" 
                               class="btn btn-outline-secondary btn-sm d-flex align-items-center px-3" title="View Details">
                                <i class="bi bi-eye"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
