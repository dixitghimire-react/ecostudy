@model EcoStudy.Models.Chapter

@{
    ViewData["Title"] = $"Edit Chapter {Model.ChapterNumber}";
    Layout = "_DashboardLayout";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Teacher" asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-controller="Teacher" asp-action="Chapters" class="text-decoration-none">Chapters</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit Chapter @Model.ChapterNumber</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="custom-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper icon-blue mb-0">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-0">Edit Chapter</h4>
                        <p class="text-muted small mb-0">Modify details for Chapter @Model.ChapterNumber: @Model.Name</p>
                    </div>
                </div>
                <span class="badge bg-secondary">ID #@Model.Id</span>
            </div>

            <form asp-controller="Teacher" asp-action="EditChapter" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="ChapterNumber" class="form-label fw-semibold small text-secondary">
                            Chapter Number <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-hash text-muted"></i></span>
                            <input asp-for="ChapterNumber" type="number" min="1" max="999" class="form-control bg-light border-start-0 ps-0" />
                        </div>
                        <span asp-validation-for="ChapterNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold small text-secondary">
                            Chapter Name <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-type text-muted"></i></span>
                            <input asp-for="Name" class="form-control bg-light border-start-0 ps-0" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="SubjectArea" class="form-label fw-semibold small text-secondary">
                            Subject Area / Category
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-tag text-muted"></i></span>
                            <select asp-for="SubjectArea" class="form-select bg-light border-start-0 ps-0">
                                <option value="Microeconomics">Microeconomics</option>
                                <option value="Macroeconomics">Macroeconomics</option>
                                <option value="Development Economics">Development Economics</option>
                                <option value="Quantitative Economics">Quantitative Economics</option>
                            </select>
                        </div>
                        <span asp-validation-for="SubjectArea" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold small text-secondary">
                            Chapter Description / Syllabus Scope
                        </label>
                        <textarea asp-for="Description" class="form-control bg-light" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Timestamps Metadata -->
                <div class="row g-2 p-3 bg-light rounded-3 small text-muted mb-4 border">
                    <div class="col-sm-6">
                        <i class="bi bi-clock-history me-1"></i> <strong>Created At:</strong> @Model.CreatedAt.ToString("MMMM dd, yyyy 'at' hh:mm tt") UTC
                    </div>
                    <div class="col-sm-6">
                        <i class="bi bi-pencil me-1"></i> <strong>Last Updated:</strong> @(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("MMMM dd, yyyy 'at' hh:mm tt") + " UTC" : "Not yet modified")
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-controller="Teacher" asp-action="Chapters" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary-custom px-4">
                        <i class="bi bi-save me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
