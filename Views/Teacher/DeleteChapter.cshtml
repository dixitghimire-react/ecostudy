@model EcoStudy.Models.Chapter

@{
    ViewData["Title"] = $"Delete Chapter {Model.ChapterNumber}";
    Layout = "_DashboardLayout";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Teacher" asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-controller="Teacher" asp-action="Chapters" class="text-decoration-none">Chapters</a></li>
        <li class="breadcrumb-item active" aria-current="page">Delete Confirmation</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="custom-card p-4 border-danger border-opacity-50">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-danger border-opacity-25">
                <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-inline-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-trash-fill fs-3"></i>
                </div>
                <div>
                    <h4 class="fw-bold text-danger mb-0">Confirm Chapter Deletion</h4>
                    <p class="text-muted small mb-0">Please review the details below before proceeding with deletion</p>
                </div>
            </div>

            <div class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 mt-1"></i>
                <div>
                    <strong>Warning:</strong> Deleting this chapter is a permanent action. All associated data will be removed from SQL Server.
                </div>
            </div>

            <div class="p-3 bg-light rounded-3 border mb-4">
                <div class="row g-3 small">
                    <div class="col-sm-4 text-muted">Chapter Number:</div>
                    <div class="col-sm-8 fw-bold text-dark">Chapter @Model.ChapterNumber</div>

                    <div class="col-sm-4 text-muted">Chapter Name:</div>
                    <div class="col-sm-8 fw-bold text-dark">@Model.Name</div>

                    <div class="col-sm-4 text-muted">Subject Area:</div>
                    <div class="col-sm-8">
                        <span class="badge @(Model.SubjectArea == "Microeconomics" ? "badge-soft-primary" : "badge-soft-success")">
                            @(string.IsNullOrEmpty(Model.SubjectArea) ? "Economics" : Model.SubjectArea)
                        </span>
                    </div>

                    <div class="col-sm-4 text-muted">Description:</div>
                    <div class="col-sm-8 text-secondary">
                        @(string.IsNullOrEmpty(Model.Description) ? "—" : Model.Description)
                    </div>

                    <div class="col-sm-4 text-muted">Created At:</div>
                    <div class="col-sm-8 text-secondary">@Model.CreatedAt.ToString("MMMM dd, yyyy")</div>
                </div>
            </div>

            <form asp-controller="Teacher" asp-action="DeleteChapter" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-controller="Teacher" asp-action="Chapters" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Cancel, Keep Chapter
                    </a>
                    <button type="submit" class="btn btn-danger px-4 fw-semibold">
                        <i class="bi bi-trash-fill me-1"></i> Yes, Permanently Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
