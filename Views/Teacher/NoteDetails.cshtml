@model EcoStudy.Models.Note
@inject EcoStudy.Services.IFileService FileService

@{
    ViewData["Title"] = Model.Title;
    Layout = "_DashboardLayout";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Teacher" asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-controller="Teacher" asp-action="Notes" class="text-decoration-none">Notes</a></li>
        <li class="breadcrumb-item active" aria-current="page">Note Details</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="custom-card p-4">
            <!-- Header -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-3 pb-3 border-bottom mb-4">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        @if (Model.Chapter != null)
                        {
                            <span class="badge bg-secondary">Ch @Model.Chapter.ChapterNumber: @Model.Chapter.Name</span>
                            <span class="badge @(Model.Chapter.SubjectArea == "Microeconomics" ? "badge-soft-primary" : "badge-soft-success")">
                                @Model.Chapter.SubjectArea
                            </span>
                        }
                    </div>
                    <h3 class="fw-bold text-dark mb-1">@Model.Title</h3>
                    <div class="text-muted small">
                        <span><i class="bi bi-person-check me-1"></i>Uploaded by @(Model.Teacher?.FullName ?? "Economics Faculty")</span>
                        <span class="ms-3"><i class="bi bi-calendar3 me-1"></i>@Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Teacher" asp-action="EditNote" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="openDeleteNoteModal(@Model.Id, '@Html.Raw(Model.Title.Replace("'", "\\'"))', '@Html.Raw(Model.FileName.Replace("'", "\\'"))')">
                        <i class="bi bi-trash me-1"></i> Delete
                    </button>
                </div>
            </div>

            <!-- Description -->
            <div class="mb-4">
                <h6 class="fw-bold text-dark text-uppercase small tracking-wider mb-2">Description / Syllabus Scope</h6>
                <div class="p-3 bg-light rounded-3 border text-secondary" style="line-height: 1.7;">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided for this document." : Model.Description)
                </div>
            </div>

            <!-- Download Card -->
            <div class="p-4 rounded-4 border bg-white shadow-sm mb-4">
                <div class="row align-items-center gy-3">
                    <div class="col-sm-8 d-flex align-items-center gap-3">
                        <div class="fs-1">
                            <i class="bi @FileService.GetFileIcon(Model.FileType)"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark fs-6">@Model.FileName</div>
                            <div class="text-muted small">
                                Format: <span class="badge @FileService.GetFileBadgeClass(Model.FileType) text-uppercase">@Model.FileType.TrimStart('.')</span> &bull; 
                                File Size: <strong>@FileService.FormatFileSize(Model.FileSize)</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 text-sm-end">
                        <a asp-controller="Teacher" asp-action="DownloadNote" asp-route-id="@Model.Id" class="btn btn-primary-custom px-4">
                            <i class="bi bi-download me-1"></i> Download
                        </a>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                <a asp-controller="Teacher" asp-action="Notes" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Notes
                </a>
                @if (Model.ChapterId > 0)
                {
                    <a asp-controller="Teacher" asp-action="ChapterDetails" asp-route-id="@Model.ChapterId" class="btn btn-outline-info">
                        <i class="bi bi-journal-bookmark me-1"></i> View Chapter
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap 5 Delete Note Confirmation Modal -->
<div class="modal fade" id="deleteNoteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Note Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="deleteNoteForm" method="post" asp-controller="Teacher" asp-action="DeleteNote">
                @Html.AntiForgeryToken()
                <input type="hidden" id="modalNoteId" name="id" value="" />

                <div class="modal-body p-4">
                    <p class="text-secondary mb-2">Are you sure you want to permanently delete this study note and its attached document?</p>
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <h6 class="fw-bold text-dark mb-1" id="modalNoteTitle"></h6>
                        <div class="small text-secondary" id="modalNoteFileName"></div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-semibold">
                        <i class="bi bi-trash-fill me-1"></i> Yes, Delete Note
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDeleteNoteModal(id, title, fileName) {
            document.getElementById('modalNoteId').value = id;
            document.getElementById('modalNoteTitle').textContent = title;
            document.getElementById('modalNoteFileName').textContent = `File: ${fileName}`;
            var myModal = new bootstrap.Modal(document.getElementById('deleteNoteModal'));
            myModal.show();
        }
    </script>
}
