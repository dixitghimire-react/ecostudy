@model IEnumerable<EcoStudy.Models.Note>
@inject EcoStudy.Services.IFileService FileService

@{
    ViewData["Title"] = "Notes Management";
    Layout = "_DashboardLayout";
    var chapters = ViewBag.Chapters as List<EcoStudy.Models.Chapter> ?? new List<EcoStudy.Models.Chapter>();
    int? selectedChapterId = ViewBag.SelectedChapterId as int?;
}

<!-- Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Notes Management</h3>
        <p class="text-muted small mb-0">Upload, organize, edit, and distribute economics study materials and handouts</p>
    </div>
    <div>
        <a asp-controller="Teacher" asp-action="UploadNote" asp-route-chapterId="@selectedChapterId" class="btn btn-primary-custom d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-cloud-arrow-up-fill"></i>
            <span>Upload New Note</span>
        </a>
    </div>
</div>

<!-- Filter Bar -->
<div class="custom-card p-3 mb-4">
    <div class="row g-3 align-items-center justify-content-between">
        <div class="col-md-5">
            <div class="d-flex align-items-center gap-2">
                <label class="text-muted small fw-semibold text-nowrap"><i class="bi bi-funnel me-1"></i>Filter Chapter:</label>
                <select class="form-select form-select-sm" onchange="location = this.value;">
                    <option value="@Url.Action("Notes", "Teacher")">All Chapters (@chapters.Count)</option>
                    @foreach (var ch in chapters)
                    {
                        if (selectedChapterId == ch.Id)
                        {
                            <option value="@Url.Action("Notes", "Teacher", new { chapterId = ch.Id })" selected>
                                Ch @ch.ChapterNumber: @ch.Name
                            </option>
                        }
                        else
                        {
                            <option value="@Url.Action("Notes", "Teacher", new { chapterId = ch.Id })">
                                Ch @ch.ChapterNumber: @ch.Name
                            </option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="col-md-7 text-md-end">
            <div class="d-inline-flex flex-wrap gap-2 small text-muted align-items-center">
                <span>Accepted Formats:</span>
                <span class="badge badge-soft-danger"><i class="bi bi-filetype-pdf me-1"></i>PDF</span>
                <span class="badge badge-soft-primary"><i class="bi bi-filetype-docx me-1"></i>DOC / DOCX</span>
                <span class="badge badge-soft-warning"><i class="bi bi-filetype-pptx me-1"></i>PPT / PPTX</span>
            </div>
        </div>
    </div>
</div>

<!-- Notes Table / Cards -->
<div class="custom-card">
    <div class="custom-card-header">
        <h6 class="custom-card-title">
            <i class="bi bi-folder2-open text-primary"></i> Published Economics Study Notes
        </h6>
        <span class="badge bg-secondary">@Model.Count() files</span>
    </div>
    <div class="custom-card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center">
                <i class="bi bi-file-earmark-x fs-1 text-muted"></i>
                <h5 class="fw-bold mt-2">No Notes Found</h5>
                <p class="text-muted small mb-3">No study documents have been uploaded for the selected criteria.</p>
                <a asp-controller="Teacher" asp-action="UploadNote" asp-route-chapterId="@selectedChapterId" class="btn btn-primary-custom btn-sm">
                    <i class="bi bi-cloud-arrow-up me-1"></i> Upload First Note
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Document Title</th>
                            <th>Chapter</th>
                            <th>Attached File</th>
                            <th>Size</th>
                            <th>Uploaded Date</th>
                            <th class="text-end" style="min-width: 180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var note in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="fs-4">
                                            <i class="bi @FileService.GetFileIcon(note.FileType)"></i>
                                        </div>
                                        <div>
                                            <a asp-controller="Teacher" asp-action="NoteDetails" asp-route-id="@note.Id" class="fw-bold text-dark text-decoration-none hover-primary">
                                                @note.Title
                                            </a>
                                            @if (!string.IsNullOrEmpty(note.Description))
                                            {
                                                <div class="text-muted text-truncate" style="max-width: 250px; font-size: 0.75rem;">
                                                    @note.Description
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (note.Chapter != null)
                                    {
                                        <span class="badge bg-secondary">Ch @note.Chapter.ChapterNumber</span>
                                        <div class="text-muted text-truncate mt-1" style="max-width: 140px; font-size: 0.75rem;">
                                            @note.Chapter.Name
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @FileService.GetFileBadgeClass(note.FileType) text-uppercase">
                                        @note.FileType.TrimStart('.')
                                    </span>
                                    <span class="text-secondary small d-block text-truncate mt-1" style="max-width: 160px;" title="@note.FileName">
                                        @note.FileName
                                    </span>
                                </td>
                                <td class="text-muted text-nowrap">
                                    @FileService.FormatFileSize(note.FileSize)
                                </td>
                                <td class="text-muted text-nowrap">
                                    <i class="bi bi-calendar3 me-1"></i>@note.CreatedAt.ToString("MMM dd, yyyy")
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <!-- Download -->
                                        <a asp-controller="Teacher" asp-action="DownloadNote" asp-route-id="@note.Id" 
                                           class="btn btn-outline-success" title="Download Document">
                                            <i class="bi bi-download"></i>
                                        </a>
                                        <!-- Details -->
                                        <a asp-controller="Teacher" asp-action="NoteDetails" asp-route-id="@note.Id" 
                                           class="btn btn-outline-info" title="View Note Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <!-- Edit -->
                                        <a asp-controller="Teacher" asp-action="EditNote" asp-route-id="@note.Id" 
                                           class="btn btn-outline-primary" title="Edit Note Information">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <!-- Delete (Modal trigger) -->
                                        <button type="button" class="btn btn-outline-danger" title="Delete Note"
                                                onclick="openDeleteNoteModal(@note.Id, '@Html.Raw(note.Title.Replace("'", "\\'"))', '@Html.Raw(note.FileName.Replace("'", "\\'"))')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Bootstrap 5 Delete Note Confirmation Modal -->
<div class="modal fade" id="deleteNoteModal" tabindex="-1" aria-labelledby="deleteNoteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="deleteNoteLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Note Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="deleteNoteForm" method="post" asp-controller="Teacher" asp-action="DeleteNote">
                @Html.AntiForgeryToken()
                <input type="hidden" id="modalNoteId" name="id" value="" />

                <div class="modal-body p-4">
                    <p class="text-secondary mb-2">Are you sure you want to permanently delete this study note and its attached file?</p>
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="small text-muted mb-1">Target Note:</div>
                        <h6 class="fw-bold text-dark mb-1" id="modalNoteTitle"></h6>
                        <div class="small text-secondary" id="modalNoteFileName"></div>
                    </div>
                    <div class="alert alert-warning small mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                        <div>The attached physical document will be deleted from the server storage. Students will no longer be able to download it.</div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-semibold">
                        <i class="bi bi-trash-fill me-1"></i> Yes, Delete Note
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDeleteNoteModal(id, title, fileName) {
            document.getElementById('modalNoteId').value = id;
            document.getElementById('modalNoteTitle').textContent = title;
            document.getElementById('modalNoteFileName').textContent = `File: ${fileName}`;
            var myModal = new bootstrap.Modal(document.getElementById('deleteNoteModal'));
            myModal.show();
        }
    </script>
}
