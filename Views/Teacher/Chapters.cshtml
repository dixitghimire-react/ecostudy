@model IEnumerable<EcoStudy.Models.Chapter>

@{
    ViewData["Title"] = "Chapter Management";
    Layout = "_DashboardLayout";
}

<!-- Header with Action -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Chapter Management</h3>
        <p class="text-muted small mb-0">Create, modify, view, and organize economics curriculum chapters</p>
    </div>
    <div>
        <a asp-controller="Teacher" asp-action="CreateChapter" class="btn btn-primary-custom d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Create New Chapter</span>
        </a>
    </div>
</div>

<!-- Quick Statistics Bar -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="p-3 bg-white rounded-3 border d-flex align-items-center gap-3">
            <div class="stat-icon-wrapper icon-purple mb-0" style="width: 44px; height: 44px; font-size: 1.25rem;">
                <i class="bi bi-journals"></i>
            </div>
            <div>
                <div class="fw-bold fs-5 text-dark">@Model.Count()</div>
                <div class="text-muted small">Total Chapters</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-3 bg-white rounded-3 border d-flex align-items-center gap-3">
            <div class="stat-icon-wrapper icon-blue mb-0" style="width: 44px; height: 44px; font-size: 1.25rem;">
                <i class="bi bi-diagram-3"></i>
            </div>
            <div>
                <div class="fw-bold fs-5 text-dark">@Model.Count(c => c.SubjectArea == "Microeconomics")</div>
                <div class="text-muted small">Microeconomics</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-3 bg-white rounded-3 border d-flex align-items-center gap-3">
            <div class="stat-icon-wrapper icon-emerald mb-0" style="width: 44px; height: 44px; font-size: 1.25rem;">
                <i class="bi bi-globe-americas"></i>
            </div>
            <div>
                <div class="fw-bold fs-5 text-dark">@Model.Count(c => c.SubjectArea == "Macroeconomics")</div>
                <div class="text-muted small">Macroeconomics</div>
            </div>
        </div>
    </div>
</div>

<!-- Chapters Table / Card -->
<div class="custom-card">
    <div class="custom-card-header">
        <h6 class="custom-card-title">
            <i class="bi bi-list-columns-reverse text-primary"></i> Curriculum Chapters List
        </h6>
        <span class="badge bg-secondary">@Model.Count() records</span>
    </div>
    <div class="custom-card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center">
                <i class="bi bi-journal-x fs-1 text-muted"></i>
                <h5 class="fw-bold mt-2">No Chapters Created Yet</h5>
                <p class="text-muted small mb-3">Begin by creating your first Economics curriculum chapter.</p>
                <a asp-controller="Teacher" asp-action="CreateChapter" class="btn btn-primary-custom btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> Add Chapter
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th style="width: 90px;">Chapter #</th>
                            <th>Chapter Name</th>
                            <th>Description</th>
                            <th>Subject Area</th>
                            <th>Created At</th>
                            <th>Updated At</th>
                            <th class="text-end" style="min-width: 170px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var ch in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-dark rounded-pill px-3 py-1">Ch @ch.ChapterNumber</span>
                                </td>
                                <td class="fw-bold text-dark">
                                    <a asp-controller="Teacher" asp-action="ChapterDetails" asp-route-id="@ch.Id" class="text-decoration-none text-dark hover-primary">
                                        @ch.Name
                                    </a>
                                </td>
                                <td>
                                    <span class="text-muted text-truncate d-inline-block" style="max-width: 260px;" title="@ch.Description">
                                        @(string.IsNullOrEmpty(ch.Description) ? "—" : ch.Description)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(ch.SubjectArea == "Microeconomics" ? "badge-soft-primary" : "badge-soft-success")">
                                        @(string.IsNullOrEmpty(ch.SubjectArea) ? "Economics" : ch.SubjectArea)
                                    </span>
                                </td>
                                <td class="text-muted text-nowrap">
                                    <i class="bi bi-calendar-event me-1"></i>@ch.CreatedAt.ToString("MMM dd, yyyy")
                                </td>
                                <td class="text-muted text-nowrap">
                                    @if (ch.UpdatedAt.HasValue)
                                    {
                                        <span class="badge badge-soft-warning" title="@ch.UpdatedAt.Value.ToString("g")">
                                            <i class="bi bi-pencil me-1"></i>@ch.UpdatedAt.Value.ToString("MMM dd, yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <!-- View Details -->
                                        <a asp-controller="Teacher" asp-action="ChapterDetails" asp-route-id="@ch.Id" 
                                           class="btn btn-outline-info" title="View Chapter Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <!-- Edit -->
                                        <a asp-controller="Teacher" asp-action="EditChapter" asp-route-id="@ch.Id" 
                                           class="btn btn-outline-primary" title="Edit Chapter">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <!-- Delete (Modal trigger) -->
                                        <button type="button" class="btn btn-outline-danger" title="Delete Chapter"
                                                onclick="openDeleteModal(@ch.Id, @ch.ChapterNumber, '@Html.Raw(ch.Name.Replace("'", "\\'"))')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Bootstrap 5 Delete Confirmation Modal -->
<div class="modal fade" id="deleteChapterModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Delete Chapter
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="deleteChapterForm" method="post" asp-controller="Teacher" asp-action="DeleteChapter">
                @Html.AntiForgeryToken()
                <input type="hidden" id="modalChapterId" name="id" value="" />

                <div class="modal-body p-4">
                    <p class="text-secondary mb-2">Are you sure you want to permanently delete this chapter?</p>
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="small text-muted mb-1">Target Chapter:</div>
                        <h6 class="fw-bold text-dark mb-0" id="modalChapterTitle"></h6>
                    </div>
                    <div class="alert alert-warning small mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                        <div>This action is permanent and cannot be undone. Associated study materials will also be removed.</div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-semibold">
                        <i class="bi bi-trash-fill me-1"></i> Yes, Delete Chapter
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDeleteModal(id, number, name) {
            document.getElementById('modalChapterId').value = id;
            document.getElementById('modalChapterTitle').textContent = `Chapter ${number} — ${name}`;
            var myModal = new bootstrap.Modal(document.getElementById('deleteChapterModal'));
            myModal.show();
        }
    </script>
}
