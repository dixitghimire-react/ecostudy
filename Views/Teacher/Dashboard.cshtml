@model EcoStudy.Models.ViewModels.TeacherDashboardViewModel

@{
    ViewData["Title"] = "Teacher Dashboard";
    Layout = "_DashboardLayout";
}

<!-- Welcome Banner -->
<div class="p-4 p-md-5 rounded-4 mb-4 text-white shadow-sm position-relative overflow-hidden" 
     style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);">
    <div class="row align-items-center position-relative" style="z-index: 2;">
        <div class="col-lg-8">
            <div class="badge bg-white bg-opacity-25 text-white px-3 py-1 rounded-pill mb-2 fw-semibold">
                <i class="bi bi-shield-check me-1"></i> Faculty Control Panel
            </div>
            <h2 class="fw-bold mb-2">Welcome back, @Model.TeacherName!</h2>
            <p class="text-light text-opacity-80 mb-3 fs-6" style="max-width: 600px;">
                Organize economics curriculum chapters, upload and verify lecture handouts, curate high-yield exam questions, and manage student access.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Teacher" asp-action="CreateChapter" class="btn btn-light text-primary fw-bold btn-sm px-3 rounded-pill">
                    <i class="bi bi-plus-circle-fill me-1"></i> New Chapter
                </a>
                <a asp-controller="Teacher" asp-action="UploadNote" class="btn btn-outline-light btn-sm px-3 rounded-pill">
                    <i class="bi bi-cloud-arrow-up me-1"></i> Upload Handout
                </a>
                <a asp-controller="Teacher" asp-action="AddQuestion" class="btn btn-outline-light btn-sm px-3 rounded-pill">
                    <i class="bi bi-patch-question me-1"></i> Add Question
                </a>
            </div>
        </div>
        <div class="col-lg-4 text-lg-end mt-4 mt-lg-0 d-none d-lg-block">
            <div class="display-1 text-white text-opacity-25"><i class="bi bi-graph-up-arrow"></i></div>
        </div>
    </div>
</div>

<!-- 4 Key Stat Metrics -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-sm-6">
        <a asp-controller="Teacher" asp-action="Chapters" class="text-decoration-none">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="stat-icon-wrapper icon-purple">
                        <i class="bi bi-journal-bookmark-fill"></i>
                    </div>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill small">Syllabus</span>
                </div>
                <div class="stat-value">@Model.TotalChapters</div>
                <div class="stat-label">Total Chapters</div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-sm-6">
        <a asp-controller="Teacher" asp-action="Notes" class="text-decoration-none">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="stat-icon-wrapper icon-blue">
                        <i class="bi bi-file-earmark-text-fill"></i>
                    </div>
                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill small">Documents</span>
                </div>
                <div class="stat-value">@Model.TotalNotes</div>
                <div class="stat-label">Total Study Notes</div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-sm-6">
        <a asp-controller="Teacher" asp-action="ImportantQuestions" class="text-decoration-none">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="stat-icon-wrapper icon-amber">
                        <i class="bi bi-star-fill text-warning"></i>
                    </div>
                    <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 rounded-pill small">Exam Bank</span>
                </div>
                <div class="stat-value">@Model.TotalImportantQuestions</div>
                <div class="stat-label">Total Important Questions</div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-sm-6">
        <a asp-controller="Teacher" asp-action="Students" class="text-decoration-none">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="stat-icon-wrapper icon-emerald">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill small">Enrolled</span>
                </div>
                <div class="stat-value">@Model.TotalStudents</div>
                <div class="stat-label">Total Students</div>
            </div>
        </a>
    </div>
</div>

<!-- Recently Added Content Section -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold text-dark mb-0">
        <i class="bi bi-clock-history text-primary me-2"></i>Recently Added Content
    </h5>
</div>

<div class="row g-4 mb-4">
    <!-- 1. Recent Chapters -->
    <div class="col-lg-6">
        <div class="custom-card h-100">
            <div class="custom-card-header">
                <h6 class="custom-card-title">
                    <i class="bi bi-journal-check text-primary"></i> Recently Added Chapters
                </h6>
                <a asp-controller="Teacher" asp-action="Chapters" class="btn btn-sm btn-link text-decoration-none">View All</a>
            </div>
            <div class="custom-card-body p-0">
                @if (!Model.RecentChapters.Any())
                {
                    <div class="p-4 text-center text-muted small">No chapters added yet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Chapter #</th>
                                    <th>Title</th>
                                    <th>Content</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @foreach (var ch in Model.RecentChapters)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">Ch @ch.ChapterNumber</span></td>
                                        <td class="fw-semibold">
                                            <a asp-controller="Teacher" asp-action="ChapterDetails" asp-route-id="@ch.Id" class="text-decoration-none text-dark hover-primary">
                                                @ch.Name
                                            </a>
                                        </td>
                                        <td>
                                            <span class="text-muted" style="font-size: 0.78rem;">
                                                @ch.Notes.Count Notes &bull; @ch.ImportantQuestions.Count Qs
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Teacher" asp-action="ChapterDetails" asp-route-id="@ch.Id" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.75rem;">
                                                Details
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 2. Recent Study Notes -->
    <div class="col-lg-6">
        <div class="custom-card h-100">
            <div class="custom-card-header">
                <h6 class="custom-card-title">
                    <i class="bi bi-file-earmark-arrow-up-fill text-info"></i> Recently Uploaded Notes
                </h6>
                <a asp-controller="Teacher" asp-action="Notes" class="btn btn-sm btn-link text-decoration-none">View All</a>
            </div>
            <div class="custom-card-body p-0">
                @if (!Model.RecentNotes.Any())
                {
                    <div class="p-4 text-center text-muted small">No notes uploaded yet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Document Title</th>
                                    <th>Chapter</th>
                                    <th>Format</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @foreach (var note in Model.RecentNotes)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            <a asp-controller="Teacher" asp-action="NoteDetails" asp-route-id="@note.Id" class="text-decoration-none text-dark hover-primary">
                                                @note.Title
                                            </a>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">Ch @(note.Chapter?.ChapterNumber)</span></td>
                                        <td>
                                            <span class="badge bg-secondary text-uppercase" style="font-size: 0.68rem;">
                                                @note.FileType.TrimStart('.')
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Teacher" asp-action="DownloadNote" asp-route-id="@note.Id" class="btn btn-sm btn-outline-success py-0 px-2" style="font-size: 0.75rem;" title="Download">
                                                <i class="bi bi-download"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 3. Recent Important Questions -->
    <div class="col-lg-6">
        <div class="custom-card h-100">
            <div class="custom-card-header">
                <h6 class="custom-card-title">
                    <i class="bi bi-star-fill text-warning"></i> Recently Added Questions
                </h6>
                <a asp-controller="Teacher" asp-action="ImportantQuestions" class="btn btn-sm btn-link text-decoration-none">View All</a>
            </div>
            <div class="custom-card-body p-0">
                @if (!Model.RecentQuestions.Any())
                {
                    <div class="p-4 text-center text-muted small">No questions added yet.</div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var q in Model.RecentQuestions)
                        {
                            var typeBadge = q.QuestionType switch
                            {
                                "Short" => "bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25",
                                "Long" => "bg-secondary text-white",
                                "Numerical" => "bg-success bg-opacity-10 text-success border border-success border-opacity-25",
                                _ => "bg-light text-dark border"
                            };

                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="badge @typeBadge small" style="@(q.QuestionType == "Long" ? "background-color: #7c3aed !important;" : "")">@q.QuestionType</span>
                                        <span class="badge bg-light text-dark border small">@q.Marks Marks</span>
                                        <span class="text-muted small">Ch @(q.Chapter?.ChapterNumber)</span>
                                    </div>
                                    <a asp-controller="Teacher" asp-action="EditQuestion" asp-route-id="@q.Id" class="btn btn-sm btn-link text-decoration-none py-0">Edit</a>
                                </div>
                                <div class="fw-semibold text-dark text-truncate" style="font-size: 0.9rem;">
                                    @q.Question
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 4. Recently Enrolled Students -->
    <div class="col-lg-6">
        <div class="custom-card h-100">
            <div class="custom-card-header">
                <h6 class="custom-card-title">
                    <i class="bi bi-people-fill text-success"></i> Recently Registered Students
                </h6>
                <a asp-controller="Teacher" asp-action="Students" class="btn btn-sm btn-link text-decoration-none">View Directory</a>
            </div>
            <div class="custom-card-body p-0">
                @if (!Model.EnrolledStudents.Any())
                {
                    <div class="p-4 text-center text-muted small">No students registered yet.</div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var student in Model.EnrolledStudents)
                        {
                            <div class="list-group-item p-3 d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-secondary bg-opacity-25 text-dark fw-bold d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                        @student.FullName.FirstOrDefault()
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-dark" style="font-size: 0.88rem;">@student.FullName</div>
                                        <div class="text-muted small" style="font-size: 0.75rem;">@student.Email</div>
                                    </div>
                                </div>
                                <span class="badge badge-soft-primary small">@(student.GradeOrLevel ?? "Economics Student")</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
